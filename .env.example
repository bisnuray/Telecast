# ── Required ─────────────────────────────────────────────
API_ID=your_api_id
API_HASH=your_api_hash
BOT_TOKEN=your_bot_token
SESSION_STRING=your_session_string

# ── Database ─────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/vcbot

# ── Logging ──────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_CHAT_ID=your_chat_id
CACHE_CHAT_ID=your_cache_chat_id

# ── Optional limits ──────────────────────────────────────
# MAX_QUEUE_SIZE=100
# MAX_CONCURRENT_CHATS=50
# MAX_PLAYLIST_TRACKS=50
# MAX_TRACK_DURATION=7200

# ── Playback speed ───────────────────────────────────────
# Pre-download the next track while the current one plays.
# Delete each file after playback finishes.
# PREFETCH_ENABLED=true

# ── YouTube proxy ────────────────────────────────────────
# Optional. Routes yt-dlp, InnerTube search and live streams through a proxy.
# YOUTUBE_PROXY=

# ── Autoplay ─────────────────────────────────────────────
# How many related tracks to queue when autoplay is allowed.
# AUTOPLAY_BATCH_SIZE=5
# Seconds to wait for an answer to the autoplay prompt.
# AUTOPLAY_PROMPT_TIMEOUT=90

# ── Assistant idle-leave ─────────────────────────────────
# Assistant account leaves a group after this many seconds with no playback
# (0 disables). It rejoins automatically on the next play request.
# Groups where the assistant is an admin are never left.
# ASSISTANT_IDLE_LEAVE_SECONDS=3600
# ASSISTANT_IDLE_CHECK_INTERVAL=300
